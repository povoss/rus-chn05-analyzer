# 慧龄云(R)骨龄检测 API 环境变量配置
# 复制此文件为 .env 并填入真实值
# ⚠️ .env 文件切勿提交到 Git！

# === 服务端配置 ===
BONE_AGE_API_HOST=https://www.pipitu.net

# === 登录凭证 ===
# 登录账号（手机号）
BONE_AGE_USERNAME=your_phone_number
# 登录密码（SHA256 加密后的值）
# 生成方式: echo -n "your_password" | sha256sum
# 或 Python: hashlib.sha256("your_password".encode()).hexdigest()
BONE_AGE_PASSWORD_HASH=your_sha256_hashed_password

# === 终端标识 ===
# 终端唯一标识（首次运行自动生成，也可手动指定）
# BONE_AGE_TID=TID-YOUR-UNIQUE-ID

# === 角色要求 ===
# 使用第三方接口 (cosBoneAgeOnLineByThirdPartner) 需要:
# 1. 登录账号具备"第三方" Shiro 角色
# 2. counts > 0 (有剩余计算次数)
# 使用内部接口 (cosBoneAgeOnLine) 需要:
# 1. 仅需登录即可，非会员有限频(1次/30分钟)，会员无限
